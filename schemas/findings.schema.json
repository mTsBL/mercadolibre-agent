{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-agentic-scanner:findings:2.0",
  "title": "Security findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "response": {
      "type": "object", "required": ["method", "status", "content_type", "bytes", "body_sha256", "session", "truncated"], "additionalProperties": false,
      "properties": {
        "method": {"type": "string"}, "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "content_type": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "session": {"enum": ["anonymous", "authenticated", "credential_exchange"]}, "truncated": {"type": "boolean"}
      }
    },
    "finding": {
      "type": "object", "required": ["id", "type", "severity", "confidence", "url", "method", "title", "cwe", "description", "why_it_matters", "evidence", "remediation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "type": {"enum": ["sensitive_data_exposure", "http_method_tampering"]},
        "severity": {"enum": ["medium", "high"]}, "confidence": {"const": "high"}, "url": {"type": "string"},
        "method": {"type": "string"}, "title": {"type": "string"}, "cwe": {"type": "string"},
        "description": {"type": "string"}, "why_it_matters": {"type": "string"}, "remediation": {"type": "string"}, "evidence": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "sensitive_data_exposure"}}}, "then": {"properties": {"evidence": {
          "type": "object", "required": ["response", "cpf_count", "value", "validation", "access_context", "authorization_assessed"], "additionalProperties": false,
          "properties": {"response": {"$ref": "#/$defs/response"}, "cpf_count": {"type": "integer", "minimum": 1}, "value": {"const": "[CPF REDACTED]"}, "validation": {"type": "string"}, "access_context": {"enum": ["anonymous", "authenticated"]}, "authorization_assessed": {"type": "boolean"}, "related_findings": {"$ref": "#/$defs/strings"}}
        }}}},
        {"if": {"properties": {"type": {"const": "http_method_tampering"}}}, "then": {"properties": {"evidence": {
          "type": "object", "required": ["mode", "baseline", "alternate", "confirmation", "unknown_method_control", "confirmed_methods", "declared_methods"], "additionalProperties": false,
          "properties": {"mode": {"enum": ["authorization_bypass", "unsafe_method_state_change", "declared_method_violation"]}, "baseline": {"$ref": "#/$defs/response"}, "alternate": {"$ref": "#/$defs/response"}, "confirmation": {"$ref": "#/$defs/response"}, "unknown_method_control": {"$ref": "#/$defs/response"}, "authenticated_reference": {"$ref": "#/$defs/response"}, "legitimate_method": {"$ref": "#/$defs/response"}, "state_before": {"$ref": "#/$defs/response"}, "state_after": {"$ref": "#/$defs/response"}, "confirmed_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]}}, "declared_methods": {"$ref": "#/$defs/strings"}}
        }}}}
      ]
    }
  }
}
